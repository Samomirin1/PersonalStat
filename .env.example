# Discord bot credentials (Discord Developer Portal -> your application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set during development to register slash commands instantly to one server
# instead of waiting ~1hr for global command propagation. Leave blank in production.
DISCORD_GUILD_ID=

# Anthropic API key for parsing box score screenshots
ANTHROPIC_API_KEY=

# Postgres connection string. On Railway, add the Postgres plugin and it
# auto-populates this as a reference variable (${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# Optional: Discord role ID allowed to run admin commands (/upload,
# /removeplayer, /deletegame, /merge, /season new). If unset, falls back to
# anyone with the "Manage Server" permission.
ADMIN_ROLE_ID=

# Optional: an extra Discord role ID (e.g. "Lobby Leader") allowed to use
# /upload specifically, without needing full admin rights. Admins can
# always upload regardless of this setting.
UPLOAD_ROLE_ID=
